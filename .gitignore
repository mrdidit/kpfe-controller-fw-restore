# Publish only the restore app and its pinned runtime dependencies.
/*
!/.gitignore
!/README.md
!/restore-app/
!/updater/

/restore-app/*
!/restore-app/build.py
!/restore-app/README.md
!/restore-app/android/
!/restore-app/core/
!/restore-app/tests/
!/restore-app/vendor/

# Detailed research notes stay in the local workspace.
/restore-app/core/test/DESIGN.txt

/updater/*
!/updater/KPFE-stock/
/updater/KPFE-stock/*
!/updater/KPFE-stock/KPFE_KR02_v8.bin
!/updater/KPFE-stock/KPFE_KR02_v9.bin
!/updater/KPFE-stock/SHA256SUMS
!/updater/KPFE-stock/README.md

**/__pycache__/
*.py[cod]
*.class
*.log
*.apk
*.p12
*.pfx
*.jks
*.keystore
*.pem
*.key
password.txt
.env
.env.*
